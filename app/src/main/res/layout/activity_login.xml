<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <FrameLayout
        android:background="@color/background_yellow"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <com.google.android.material.imageview.ShapeableImageView
            android:layout_width="300dp"
            android:layout_height="200dp"
            android:layout_gravity="top"
            android:layout_marginTop="45dp"
            android:background="@android:color/transparent"
            android:layout_marginStart="50dp"
            android:layout_marginEnd="10dp"
            android:src="@drawable/gopark_logo_transparent"
            android:scaleType="centerCrop" />

        <LinearLayout
            android:layout_gravity="center_vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="30dp"
            android:layout_margin="10sp">

            <TextView
                android:id="@+id/login_email_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Email"
                android:fontFamily="monospace"
                android:textColor="@color/brand_navy"
                android:layout_gravity="start"
                android:layout_marginLeft="10dp"
                android:textStyle="bold"
                android:textSize="16sp"/>

            <EditText
                android:id="@+id/login_input_email"
                android:layout_margin="10dp"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:fontFamily="sans-serif"
                android:cursorVisible="true"
                android:padding="10sp"
                android:textColor="@color/brand_navy"
                android:background="@drawable/input_border" />

            <TextView
                android:id="@+id/login_password_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Password"
                android:fontFamily="monospace"
                android:textColor="@color/brand_navy"
                android:layout_gravity="start"
                android:layout_marginLeft="10dp"
                android:textStyle="bold"
                android:textSize="16sp"/>

            <EditText
                android:id="@+id/login_input_password"
                android:layout_margin="10dp"
                android:layout_width="match_parent"
                android:layout_height="45dp"
                android:cursorVisible="true"
                android:padding="10sp"
                android:fontFamily="sans-serif"
                android:inputType="textPassword"
                android:textColor="@color/brand_navy"
                android:background="@drawable/input_border"/>

            <LinearLayout
                android:layout_gravity="center"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="10dp"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/forgot_password_link"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/forgot_password"
                    android:textSize="15sp"
                    android:textColor="@color/brand_navy"
                    android:fontFamily="sans-serif"
                    android:layout_marginLeft="10dp"
                    android:textStyle="italic"
                    android:linksClickable="true" />

                <Space
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"/>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/login_button"
                    android:layout_width="120dp"
                    android:layout_height="52dp"
                    android:layout_gravity="end"
                    app:backgroundTint="@color/brand_orange"
                    android:fontFamily="sans-serif"
                    android:text="Log in"
                    android:textColor="@color/white"
                    android:textStyle="bold"
                    app:cornerRadius="8dp" />

            </LinearLayout>
        </LinearLayout>

        <include layout="@layout/layout_notification" />
        <include layout="@layout/layout_loader" />
    </FrameLayout>
</androidx.constraintlayout.widget.ConstraintLayout>