<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#1a1a1a"
    tools:ignore="HardcodedText,ContentDescription,UselessParent,Overlap">

    <com.thesis.thesisapplication.helpers.ParkingSelectorView
        android:id="@+id/parking_selector_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Container for Drag and Drop -->
    <LinearLayout
        android:id="@+id/fab_menu_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentEnd="true"
        android:layout_marginTop="48dp"
        android:layout_marginEnd="16dp"
        android:orientation="vertical"
        android:gravity="end">

        <!-- Modern Hamburger "Bar" Toggle Button -->
        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/fab_menu_toggle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:src="@android:drawable/ic_menu_sort_by_size"
            app:backgroundTint="@color/brand_navy"
            app:tint="@android:color/white"
            app:fabCustomSize="56dp" />

        <LinearLayout
            android:id="@+id/fab_menu_group"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <com.google.android.material.floatingactionbutton.FloatingActionButton
                android:id="@+id/fab_profile"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:src="@android:drawable/ic_menu_myplaces"
                app:backgroundTint="@android:color/white"
                app:tint="@color/brand_navy"
                app:fabCustomSize="48dp" />

            <com.google.android.material.floatingactionbutton.FloatingActionButton
                android:id="@+id/fab_settings"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:src="@android:drawable/ic_menu_manage"
                app:backgroundTint="@android:color/white"
                app:tint="@color/brand_navy"
                app:fabCustomSize="48dp" />

            <com.google.android.material.floatingactionbutton.FloatingActionButton
                android:id="@+id/fab_about"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:src="@android:drawable/ic_menu_info_details"
                app:backgroundTint="@android:color/white"
                app:tint="@color/brand_navy"
                app:fabCustomSize="48dp" />

            <com.google.android.material.floatingactionbutton.FloatingActionButton
                android:id="@+id/fab_logout"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@android:drawable/ic_lock_power_off"
                app:backgroundTint="#F44336"
                app:tint="@android:color/white"
                app:fabCustomSize="48dp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Modernized Bottom Card -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/bottom_parking_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_margin="12dp"
        android:visibility="gone"
        app:cardCornerRadius="24dp"
        app:cardElevation="12dp"
        app:strokeWidth="0dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="24dp"
            android:paddingTop="20dp"
            android:paddingBottom="24dp">

            <!-- Title & Sleek Navigation Arrows -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/card_slot_title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Parking Slot"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    android:textColor="@color/brand_navy" />

                <!-- Modern Circular Left Arrow -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_prev_slot"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:text="❮"
                    android:textSize="18sp"
                    android:textColor="@color/brand_navy"
                    app:backgroundTint="#F0F0F0"
                    app:cornerRadius="22dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:padding="0dp" />

                <!-- Modern Circular Right Arrow -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_next_slot"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_marginStart="8dp"
                    android:text="❯"
                    android:textSize="18sp"
                    android:textColor="@color/brand_navy"
                    app:backgroundTint="#F0F0F0"
                    app:cornerRadius="22dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:padding="0dp" />
            </LinearLayout>

            <TextView
                android:id="@+id/card_slot_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:layout_marginBottom="20dp"
                android:text="Status: Checking..."
                android:textSize="16sp"
                android:textStyle="bold" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_navigate_here"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="Navigate"
                android:textColor="@android:color/white"
                android:textSize="16sp"
                android:textStyle="bold"
                app:backgroundTint="@color/brand_navy"
                app:cornerRadius="16dp" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

</RelativeLayout>