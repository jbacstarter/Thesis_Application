<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"

    >

    <FrameLayout

        android:background="#33434F"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        >
        <com.google.android.material.imageview.ShapeableImageView
            android:layout_width="300dp"
            android:layout_height="200dp"
            android:layout_gravity="top"
            android:layout_marginTop="45dp"
            android:background="@android:color/transparent"
            android:layout_marginStart="50dp"
            android:layout_marginEnd="10dp"
            android:src="@drawable/temp_logo"
            android:scaleType="centerCrop" />


        <LinearLayout
            android:layout_gravity="center_vertical
"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="30dp"
            android:layout_margin="10sp">
            <TextView
                android:id="@+id/reg_email_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Email"
                android:fontFamily="monospace"
                android:textColor="@color/white"
                android:layout_gravity="start"
                android:layout_marginLeft="10dp"
                android:textStyle="bold"
                android:textSize="16sp"/>
            <EditText
                android:id="@+id/reg_input_email"
                android:layout_margin="10dp"
                android:layout_width="match_parent"
                android:layout_height="45dp"
                android:fontFamily="sans-serif"
                android:cursorVisible="true"
                android:padding="10sp"
                android:textColor="#2D3B45"
                android:background="@drawable/input_border"
                />
            <TextView
                android:id="@+id/reg_password_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Password"
                android:fontFamily="monospace"
                android:textColor="@color/white"
                android:layout_gravity="start"
                android:layout_marginLeft="10dp"
                android:textStyle="bold"
                android:textSize="16sp"/>
            <EditText
                android:id="@+id/reg_input_password"
                android:layout_margin="10dp"
                android:layout_width="match_parent"
                android:layout_height="45dp"
                android:cursorVisible="true"
                android:padding="10sp"
                android:fontFamily="sans-serif"
                android:textColor="#2D3B45"
                android:background="@drawable/input_border"/>
            <com.google.android.material.button.MaterialButton
                android:id="@+id/reg_button"
                android:layout_margin="10dp"
                android:layout_width="wrap_content"
                android:layout_height="45dp"
                android:text="Register"
                android:layout_gravity="end"
                android:fontFamily="sans-serif"
                android:textStyle="bold"
                app:cornerRadius="2dp"
                app:strokeColor="@color/white"
                app:strokeWidth="2dp"
                android:textColor="@color/white"
                android:backgroundTint="@android:color/transparent"
                />
        </LinearLayout>



    </FrameLayout>



</androidx.constraintlayout.widget.ConstraintLayout>